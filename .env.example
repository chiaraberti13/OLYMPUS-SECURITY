# Copy to .env and fill in. NEVER commit .env.
# Olympus reads all secrets/config from the environment.
OLYMPUS_LOG_LEVEL=INFO
# Optional operational telemetry. Default is none (no export, no listener).
# OLYMPUS_OBSERVABILITY_BACKEND=otlp
# OLYMPUS_OBSERVABILITY_OTLP_ENDPOINT=http://127.0.0.1:4318
# OLYMPUS_OBSERVABILITY_SERVICE_NAME=olympus-security
# OLYMPUS_OBSERVABILITY_CARDINALITY_LIMIT=64
# For short-lived processes with the prometheus backend:
# OLYMPUS_OBSERVABILITY_PROMETHEUS_TEXTFILE=/path/to/olympus.prom
# Example third-party API keys used by Argus (optional, passive OSINT sources):
# ARGUS_CENSYS_API_ID=
# ARGUS_CENSYS_API_SECRET=
