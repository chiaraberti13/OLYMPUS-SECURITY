# Copy to .env for Compose interpolation. Credentials are supplied exclusively
# through .olympus/config/themis-api-identities.json; TLS through .olympus/tls/.
# Required setup: docs/themis-runtime.md. Do not commit real scopes or secrets.
THEMIS_API_PORT=8443
THEMIS_WEB_PORT=8600
THEMIS_ENABLE_LIVE_SCANS=false
# Optional ZAP profile requires its own dedicated secret:
# THEMIS_ZAP_API_KEY=
