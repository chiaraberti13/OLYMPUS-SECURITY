{
  "$defs": {
    "EvidenceAuthorization": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "lab_policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lab Policy Sha256"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Sha256"
        }
      },
      "title": "EvidenceAuthorization",
      "type": "object"
    },
    "EvidenceData": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pinned_version": {
          "title": "Pinned Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "pinned_version",
        "commit",
        "manifest_sha256"
      ],
      "title": "EvidenceData",
      "type": "object"
    },
    "EvidenceEngine": {
      "additionalProperties": false,
      "properties": {
        "detected_version": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected Version"
        },
        "distribution": {
          "title": "Distribution",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "pinned_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinned Version"
        },
        "source_commit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        }
      },
      "required": [
        "name",
        "distribution",
        "manifest_sha256"
      ],
      "title": "EvidenceEngine",
      "type": "object"
    },
    "EvidenceOutcome": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "finding_count": {
          "minimum": 0,
          "title": "Finding Count",
          "type": "integer"
        },
        "partial": {
          "default": false,
          "title": "Partial",
          "type": "boolean"
        },
        "partial_reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Reason"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "termination_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Cause"
        }
      },
      "required": [
        "state",
        "finding_count",
        "duration_seconds"
      ],
      "title": "EvidenceOutcome",
      "type": "object"
    },
    "EvidenceOutputs": {
      "additionalProperties": false,
      "description": "Digests of the RAW stdout/stderr. The output itself is never stored here.",
      "properties": {
        "stderr_bytes": {
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "stderr_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stderr Sha256",
          "type": "string"
        },
        "stdout_bytes": {
          "minimum": 0,
          "title": "Stdout Bytes",
          "type": "integer"
        },
        "stdout_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stdout Sha256",
          "type": "string"
        }
      },
      "required": [
        "stdout_sha256",
        "stderr_sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "title": "EvidenceOutputs",
      "type": "object"
    },
    "EvidenceScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_cidrs": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Cidrs",
          "type": "array"
        },
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Domains",
          "type": "array"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "scope_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "target": {
          "maxLength": 2048,
          "title": "Target",
          "type": "string"
        },
        "target_kind": {
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target",
        "target_kind",
        "allowed_hosts",
        "allowed_domains",
        "allowed_cidrs",
        "scope_sha256"
      ],
      "title": "EvidenceScope",
      "type": "object"
    }
  },
  "$id": "urn:olympus:schema:olympus.engine-run-evidence:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "$ref": "#/$defs/EvidenceAuthorization"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Command",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_dependencies": {
      "items": {
        "$ref": "#/$defs/EvidenceData"
      },
      "maxItems": 8,
      "title": "Data Dependencies",
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EvidenceEngine"
    },
    "outcome": {
      "$ref": "#/$defs/EvidenceOutcome"
    },
    "outputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceOutputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "olympus.engine-run-evidence",
      "default": "olympus.engine-run-evidence",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EvidenceScope"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "engine",
    "scope",
    "authorization",
    "outcome"
  ],
  "title": "EngineRunEvidence",
  "type": "object"
}
