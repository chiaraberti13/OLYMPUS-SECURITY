{
  "$defs": {
    "Source": {
      "description": "Producing module for a given object (provenance).",
      "enum": [
        "argus",
        "helios",
        "artemis",
        "proteus",
        "hermes",
        "apollo",
        "minerva",
        "vulcan",
        "athena",
        "aegis",
        "mars",
        "manual"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "$id": "urn:olympus:schema:olympus.event:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A normalized observable consumed by detection rules.",
  "properties": {
    "asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Attributes",
      "type": "object"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_name": {
      "const": "olympus.event",
      "default": "olympus.event",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    }
  },
  "required": [
    "event_type",
    "source"
  ],
  "title": "Event",
  "type": "object"
}
