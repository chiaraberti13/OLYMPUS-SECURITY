{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "A resource observed or managed by the platform (host, domain, URL...).",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "$ref": "#/$defs/AssetType"
        },
        "criticality": {
          "$ref": "#/$defs/Criticality",
          "default": "medium"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "hostname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "ip_addresses": {
          "items": {
            "type": "string"
          },
          "title": "Ip Addresses",
          "type": "array"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "schema_name": {
          "const": "olympus.asset",
          "default": "olympus.asset",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": "manual"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "asset_type"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetType": {
      "description": "Kind of asset observed or managed by the platform.",
      "enum": [
        "domain",
        "host",
        "ip",
        "web_server",
        "service",
        "url",
        "phone",
        "account",
        "other"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "Criticality": {
      "description": "Business criticality of an asset.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A weakness, vulnerability or misconfiguration attached to an asset.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "cvss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "remediation": {
          "default": "",
          "title": "Remediation",
          "type": "string"
        },
        "schema_name": {
          "const": "olympus.finding",
          "default": "olympus.finding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "medium"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus",
          "default": "new"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "source",
        "title"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingStatus": {
      "description": "Lifecycle state of a finding inside the remediation workflow.",
      "enum": [
        "new",
        "triaged",
        "confirmed",
        "false_positive",
        "accepted",
        "in_remediation",
        "closed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "ScanJob": {
      "additionalProperties": false,
      "description": "Persistable shared view of one bounded adapter invocation.",
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Id"
        },
        "schema_name": {
          "const": "olympus.scan-job",
          "default": "olympus.scan-job",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "default": "queued",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "timed_out",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "target_kind": {
          "minLength": 1,
          "title": "Target Kind",
          "type": "string"
        },
        "target_value": {
          "minLength": 1,
          "title": "Target Value",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "assessment_id",
        "adapter",
        "target_kind",
        "target_value"
      ],
      "title": "ScanJob",
      "type": "object"
    },
    "Severity": {
      "description": "Normalized severity scale shared by findings, alerts and reports.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Source": {
      "description": "Producing module for a given object (provenance).",
      "enum": [
        "argus",
        "helios",
        "artemis",
        "proteus",
        "hermes",
        "apollo",
        "minerva",
        "vulcan",
        "athena",
        "aegis",
        "mars",
        "manual"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "$id": "urn:olympus:schema:olympus.athena.result:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized, versioned output from one Athena scan job.",
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "assets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "job": {
      "$ref": "#/$defs/ScanJob"
    },
    "schema_name": {
      "const": "olympus.athena.result",
      "default": "olympus.athena.result",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "job"
  ],
  "title": "AssessmentResult",
  "type": "object"
}
