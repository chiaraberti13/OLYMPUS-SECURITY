{
  "$defs": {
    "AlertStatus": {
      "description": "Lifecycle state of a detection alert.",
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "closed"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "Severity": {
      "description": "Normalized severity scale shared by findings, alerts and reports.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Source": {
      "description": "Producing module for a given object (provenance).",
      "enum": [
        "argus",
        "helios",
        "artemis",
        "proteus",
        "hermes",
        "apollo",
        "minerva",
        "vulcan",
        "athena",
        "aegis",
        "mars",
        "manual"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "$id": "urn:olympus:schema:olympus.alert:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A detection result linked to its source event and supporting evidence.",
  "properties": {
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "mitre_attack": {
      "items": {
        "type": "string"
      },
      "title": "Mitre Attack",
      "type": "array"
    },
    "rule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    },
    "schema_name": {
      "const": "olympus.alert",
      "default": "olympus.alert",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "medium"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "status": {
      "$ref": "#/$defs/AlertStatus",
      "default": "open"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "title",
    "source"
  ],
  "title": "Alert",
  "type": "object"
}
