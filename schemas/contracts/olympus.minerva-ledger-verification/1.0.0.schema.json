{
  "$defs": {
    "MinervaLedgerEntryView": {
      "additionalProperties": false,
      "description": "Normalized, bounded projection of one verified custody entry.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "entry_hash": {
          "title": "Entry Hash",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "previous_hash": {
          "title": "Previous Hash",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "evidence_id",
        "action",
        "actor",
        "occurred_at",
        "previous_hash",
        "entry_hash"
      ],
      "title": "MinervaLedgerEntryView",
      "type": "object"
    }
  },
  "$id": "urn:olympus:schema:olympus.minerva-ledger-verification:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Minerva custody verification result for API and Web clients.\n\nThe hash chain is always verified (a non-error result means it held). The\nsignature is verified only when the server is configured with the matching\nEd25519 verification key and the ledger is signed; otherwise a signed ledger\nreports ``signature_verified=false`` so the caller refuses to trust it.",
  "properties": {
    "chain_verified": {
      "default": true,
      "title": "Chain Verified",
      "type": "boolean"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/MinervaLedgerEntryView"
      },
      "title": "Entries",
      "type": "array"
    },
    "entry_count": {
      "title": "Entry Count",
      "type": "integer"
    },
    "evidence_anchored": {
      "title": "Evidence Anchored",
      "type": "boolean"
    },
    "ledger_schema_version": {
      "title": "Ledger Schema Version",
      "type": "string"
    },
    "schema_name": {
      "const": "olympus.minerva-ledger-verification",
      "default": "olympus.minerva-ledger-verification",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_algorithm": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Algorithm"
    },
    "signature_verified": {
      "title": "Signature Verified",
      "type": "boolean"
    },
    "signed": {
      "title": "Signed",
      "type": "boolean"
    }
  },
  "required": [
    "ledger_schema_version",
    "entry_count",
    "evidence_anchored",
    "signed",
    "signature_verified",
    "entries"
  ],
  "title": "MinervaLedgerVerification",
  "type": "object"
}
